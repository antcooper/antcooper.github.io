---
layout: base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag | slugify }}/
eleventyComputed:
  title: "Posts tagged {{ tag }}"
  description: "Every post tagged {{ tag }}."
---
<div class="page">
  <h1>Tagged <span class="tag tag-heading">{{ tag }}</span></h1>

  <ul class="post-list">
    {% for post in collections.posts %}
      {% if post.data.tags and tag in post.data.tags %}
        <li class="post-list-item">
          <p class="post-meta">
            <time datetime="{{ post.date | machineDate }}">{{ post.date | readableDate }}</time>
          </p>
          <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
          {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
        </li>
      {% endif %}
    {% endfor %}
  </ul>

  <p class="all-tags">
    Browse all tags:
    {% for t in collections.tagList %}<a class="tag" href="/tags/{{ t | slugify }}/">{{ t }}</a>{% endfor %}
  </p>
</div>

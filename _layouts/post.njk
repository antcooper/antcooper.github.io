---
layout: base.njk
---
<article class="post h-entry">
  <header class="post-header">
    <h1 class="p-name">{{ title }}</h1>
    <p class="post-meta">
      <time class="dt-published" datetime="{{ page.date | machineDate }}">{{ page.date | readableDate }}</time>
      {% if tags %}
        <span class="tag-list">
          {%- for tag in tags %}<a class="tag" href="/tags/{{ tag | slugify }}/">{{ tag }}</a>{% endfor -%}
        </span>
      {% endif %}
    </p>
  </header>

  {% if image %}
    <figure class="post-hero">
      {# Eager, not lazy: this is the largest thing on screen at first paint. #}
      <img src="{{ image }}" alt="{{ imageAlt or '' }}" loading="eager" decoding="sync" fetchpriority="high">
    </figure>
  {% endif %}

  {% if description %}
    <p class="post-standfirst p-summary">{{ description }}</p>
  {% endif %}

  <div class="post-body e-content">
    {{ content | safe }}
  </div>
</article>

{# collections.posts is newest-first, so "next in the array" is the older post. #}
{% set olderPost = collections.posts | getNextCollectionItem %}
{% set newerPost = collections.posts | getPreviousCollectionItem %}
{% if olderPost or newerPost %}
  <nav class="post-nav" aria-label="More posts">
    {% if olderPost %}
      <a class="prev" href="{{ olderPost.url }}">
        <span>Older</span>{{ olderPost.data.title }}
      </a>
    {% endif %}
    {% if newerPost %}
      <a class="next" href="{{ newerPost.url }}">
        <span>Newer</span>{{ newerPost.data.title }}
      </a>
    {% endif %}
  </nav>
{% endif %}

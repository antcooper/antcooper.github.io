---
permalink: /feed.json
eleventyExcludeFromCollections: true
---
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ site.title | dump | safe }},
  "home_page_url": {{ (site.url + "/") | dump | safe }},
  "feed_url": {{ (site.url + "/feed.json") | dump | safe }},
  "description": {{ site.description | dump | safe }},
  "icon": {{ (site.url + site.avatar) | dump | safe }},
  "language": {{ site.language | dump | safe }},
  "authors": [
    { "name": {{ site.author.name | dump | safe }}, "url": {{ site.url | dump | safe }} }
  ],
  "items": [
    {%- for post in collections.posts %}
    {
      "id": {{ (site.url + post.url) | dump | safe }},
      "url": {{ (site.url + post.url) | dump | safe }},
      "title": {{ post.data.title | dump | safe }},
      {%- if post.data.description %}
      "summary": {{ post.data.description | dump | safe }},
      {%- endif %}
      {%- if post.data.image %}
      "image": {{ (site.url + post.data.image) | dump | safe }},
      {%- endif %}
      {%- if post.data.tags %}
      "tags": {{ post.data.tags | dump | safe }},
      {%- endif %}
      "date_published": {{ post.date.toISOString() | dump | safe }},
      "content_html": {{ post.content | htmlToAbsoluteUrls(site.url + post.url) | dump | safe }}
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
